# Copy to .env and fill in. Used only by the Nginx proxy (Docker) and the Vite dev proxy.
# Never prefix these with VITE_: they must not reach the browser bundle.
GUARDIAN_API_KEY=
NYT_API_KEY=
NEWSAPI_API_KEY=

# Dev only: serve /api/* from the test fixtures (MSW) instead of the real APIs. Not a secret.
VITE_USE_MOCKS=false
